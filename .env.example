# PostgreSQL
POSTGRES_DB=reconciliation
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon_secret
POSTGRES_PORT=5432

# API
API_PORT=8000
DEMO_MODE=true
SERVERLESS=false
DATABASE_URL=

# Optional read-only Razorpay Test Mode sync
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web
WEB_PORT=3000

# Optional advisory AI providers; deterministic fallback works without keys
GEMINI_API_KEY=
GROQ_API_KEY=

# CORS (comma-separated origins — include web container port for Docker)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
